// Prisma schema for Fitness Tracker - OCR A-Level Project

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                 String      @id @default(cuid())
  email              String      @unique
  password           String      @default("")
  name               String?
  dailyCalorieTarget Int?
  createdAt          DateTime    @default(now())

  workouts    Workout[]
  foods       FoodLog[]
  foodEntries FoodEntry[]
  goals       Goal[]
}

model Workout {
  id             String   @id @default(cuid())
  userId         String
  type           String
  durationMins   Int
  intensity      String
  caloriesBurned Int
  date           DateTime @default(now())
  notes          String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FoodLog {
  id        String   @id @default(cuid())
  userId    String
  foodName  String
  calories  Int
  mealType  String
  date      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Goal {
  id        String @id @default(cuid())
  userId    String
  target    Int
  progress  Int
  reward    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FoodEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  calories  Int
  mealType  String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}
