// Prisma schema for Fitness Tracker - OCR A-Level Project
// SQLite for portability and easy submission

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                 String      @id @default(cuid())
  email              String      @unique
  passwordHash       String
  name               String?
  dailyCalorieTarget Int?
  createdAt          DateTime    @default(now())
  workouts           Workout[]
  foodEntries        FoodEntry[]
}

model Workout {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // e.g. "Running", "Cycling", "Gym", "Swimming"
  durationMins Int     // duration in minutes
  intensity   String   // "Low", "Medium", "High"
  date        DateTime
  notes       String?
  createdAt   DateTime @default(now())
}

model FoodEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  calories  Int
  mealType  String?  // "Breakfast", "Lunch", "Dinner", "Snack"
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}
